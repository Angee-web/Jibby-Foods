# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the live site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Google Analytics 4 measurement ID (optional) e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML-tag verification code (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Show "To confirm" placeholder markers on the live site (default: hidden in production)
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# Contact & wholesale form email delivery (Resend — https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
